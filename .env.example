# Use built-in mock data (default). Set to false to call a real backend.
VITE_USE_MOCK_API=true
# Base URL of the CSPM backend API (used when VITE_USE_MOCK_API=false)
VITE_API_URL=http://localhost:8000/api
# Optional: Clerk publishable key, if you switch to Clerk auth later
VITE_CLERK_PUBLISHABLE_KEY=
